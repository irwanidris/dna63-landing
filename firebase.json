{
  "hosting": [
    {
      "target": "landing-page",
      "source": ".",
      "frameworksBackend": {
        "region": "us-central1"
      },
      "rewrites": [
        { "source": "/privacy.html", "destination": "/privacy" },
        { "source": "/delete-account.html", "destination": "/delete-account" }
      ],
      "redirects": [
        { "source": "/home", "destination": "/", "type": 301 },
        { "source": "/login", "destination": "/", "type": 301 },
        { "source": "/author/:path*", "destination": "/", "type": 301 },
        { "source": "/category/:path*", "destination": "/", "type": 301 },
        { "source": "/2025/:path*", "destination": "/", "type": 301 },
        { "source": "/wp-:path*", "destination": "/", "type": 301 }
      ]
    },
    {
      "target": "app-site",
      "source": ".",
      "frameworksBackend": {
        "region": "us-central1"
      },
      "rewrites": [
        { "source": "/privacy.html", "destination": "/privacy" },
        { "source": "/delete-account.html", "destination": "/delete-account" }
      ],
      "redirects": [
        { "source": "/home", "destination": "/", "type": 301 },
        { "source": "/login", "destination": "/", "type": 301 },
        { "source": "/author/:path*", "destination": "/", "type": 301 },
        { "source": "/category/:path*", "destination": "/", "type": 301 },
        { "source": "/2025/:path*", "destination": "/", "type": 301 },
        { "source": "/wp-:path*", "destination": "/", "type": 301 }
      ]
    }
  ],
  "apphosting": {
    "backendId": "dna63-landing",
    "rootDir": ".",
    "ignore": [
      "node_modules",
      ".git",
      "firebase-debug.log",
      "firebase-debug.*.log",
      "functions"
    ]
  }
}
